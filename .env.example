# ============================================================
# Tribu Paridas - variables de entorno compartidas (docker-compose)
# Copia este archivo a ".env" en la raíz del proyecto y ajusta valores.
# NUNCA commitees el archivo ".env" real.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=tribuparidas
POSTGRES_USER=tribuparidas
POSTGRES_PASSWORD=change-me-please
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Django backend ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# Orígenes permitidos para CORS (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Superusuario creado opcionalmente por el comando seed_data / createsuperuser
DJANGO_SUPERUSER_EMAIL=admin@tribuparidas.com
DJANGO_SUPERUSER_PASSWORD=change-me-please
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=TribuParidas

# ---- Frontend (Nuxt) ----
# URL pública de la API que consumirá el navegador (fuera de Docker)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
# URL de la API que usa el propio contenedor del frontend al renderizar en el
# servidor (SSR): "localhost" ahí apuntaría al contenedor del frontend, no al
# backend, por eso se usa el nombre del servicio Docker.
NUXT_API_BASE_SERVER=http://backend:8000/api
# Nombre del sitio, usado en metadatos
NUXT_PUBLIC_SITE_NAME=Tribu Paridas
