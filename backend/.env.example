# Variables de entorno para correr el backend FUERA de Docker (desarrollo local).
# Si usas docker-compose, estas variables ya vienen del .env de la raíz.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=tribuparidas
POSTGRES_USER=tribuparidas
POSTGRES_PASSWORD=change-me-please
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SUPERUSER_EMAIL=admin@tribuparidas.com
DJANGO_SUPERUSER_PASSWORD=change-me-please
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=TribuParidas
